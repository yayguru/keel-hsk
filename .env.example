# paper (default) never sends a transaction.
# testnet and mainnet send swaps only when VAULT_ADDRESS and AGENT_PRIVATE_KEY are set.
MODE=paper

# OpenAI-compatible chat completions. Leave the key empty to use the rule text.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Testnet or mainnet. Generate keys locally. Never commit them.
# OWNER_PRIVATE_KEY=
# AGENT_PRIVATE_KEY=
# VAULT_ADDRESS=
